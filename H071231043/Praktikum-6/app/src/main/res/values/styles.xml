<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RoundedImageStyle">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="CircleImageStyle">
        <item name="cornerSize">50%</item>
        <item name="cornerFamily">rounded</item>
    </style>
    <style name="HeaderShapeOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">42dp</item>
        <item name="cornerSizeBottomRight">42dp</item>
    </style>
    <style name="DetailTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#4B4B4B</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item> <!-- Use a modern font -->
    </style>
</resources>